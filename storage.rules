rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{kind}/{id}/{file} {
      // Any signed-in user can read public avatars
      allow read: if true;
      
      // Upload: user can only write to their own folder
      // (workspace logos should be uploaded by admins via server action using Admin SDK)
      allow write: if request.auth != null
        && (kind == "users" && request.auth.uid == id
            || kind == "workspaces" && request.auth != null)  // any authed user (server action for non-owner)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}