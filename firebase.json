{
  "apphosting": {
    "backendId": "taskpulse",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  },
  "emulators": {
    "apphosting": {
      "port": 5002,
      "rootDirectory": "/",
      "startCommand": "pnpm run dev"
    },
    "firestore": {
      "port": 8080
      
    },
    "ui": {
      "enabled": true,
      "port": 8081
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
